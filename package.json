{
	"name": "daily-briefing",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.5.1",
	"workspaces": [
		"apps/backend",
		"apps/frontend"
	],
	"scripts": {
		"dev": "pnpm --parallel --stream --filter './apps/**' run dev",
		"typecheck": "pnpm --filter './apps/**' run typecheck",
		"build": "pnpm --filter '@daily-briefing/frontend' run build",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16"
	}
}
